# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teskerti_db
DB_USER=teskerti_user
DB_PASS=change_me
DB_CHARSET=utf8mb4

# JWT
JWT_SECRET=generate_a_long_random_secret
JWT_EXPIRY=86400
JWT_REFRESH_EXPIRY=604800

# Application
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_DEBUG=false

# Mail (optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=you@example.com
MAIL_PASS=change_me
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Teskerti

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
